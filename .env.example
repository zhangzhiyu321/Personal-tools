# 环境配置
# 复制此文件为 .env 并填写实际值
# 注意：.env 文件不应提交到版本控制系统

# 运行环境: production 或 development
FLASK_ENV=production

# 数据库连接（必须配置）
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# 示例: mysql+pymysql://user:password@localhost:3306/expense_tracker?charset=utf8mb4
EXPENSE_TRACKER_DB_URI=mysql+pymysql://root:root123456@localhost:3306/expense_tracker?charset=utf8mb4

# JWT密钥（可选，不设置会自动生成）
# 建议使用: openssl rand -hex 32
JWT_SECRET_KEY=

# 管理员配置
ADMIN_USERNAME=admin
# 管理员密码哈希（使用 security/auth.py 的 AuthManager.hash_password() 生成）
# 示例: python -c "from security.auth import AuthManager; print(AuthManager.hash_password('YourPassword123!'))"
ADMIN_PASSWORD_HASH=

# 会话超时时间（秒）
SESSION_TIMEOUT=3600

# 速率限制（格式: 数量 per 时间单位）
RATE_LIMIT=100 per hour

# 备份配置
ENABLE_BACKUP=true
BACKUP_INTERVAL=24
BACKUP_RETENTION=30
