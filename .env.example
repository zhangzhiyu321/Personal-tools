# 环境配置示例文件
# 复制此文件为 .env 并填写实际值
# 注意：.env 文件不应提交到版本控制系统（已在 .gitignore 中排除）

# Flask 运行环境: production 或 development
FLASK_ENV=production

# Flask 密钥（必须配置，用于会话加密）
# 生成方法: python3 -c "import secrets; print(secrets.token_hex(16))"
FLASK_SECRET_KEY=your_secret_key_here

# 数据库连接（必须配置）
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# 示例: mysql+pymysql://user:password@localhost:3306/expense_tracker?charset=utf8mb4
EXPENSE_TRACKER_DB_URI=mysql+pymysql://username:password@localhost:3306/database_name?charset=utf8mb4

# JWT密钥（可选，不设置会自动生成）
# 生成方法: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# 数据加密密钥（可选，用于加密敏感数据）
# 生成方法: python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# 会话超时时间（秒）
# 默认: 3600 (1小时)
# 个人应用建议: 15552000 (6个月)
SESSION_TIMEOUT=15552000

# 速率限制配置（格式: 数量 per 时间单位）
# 示例: 100 per hour, 1000 per day
RATE_LIMIT=100 per hour

# 备份配置
ENABLE_BACKUP=true
BACKUP_INTERVAL=24  # 小时
BACKUP_RETENTION=30  # 天
